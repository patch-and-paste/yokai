-- Backup restore looks up history one entry at a time by chapter URL. `chapters.url` was
-- unindexed, so each of those lookups scanned the entire chapters table, making restore
-- quadratic in library size.
CREATE INDEX IF NOT EXISTS chapters_url_index ON chapters(url);

-- `scanlators_view` split `mangas.filtered_scanlators` with a recursive CTE over every row of
-- `mangas`, and was joined by every chapter, history and library query -- so it was rebuilt from
-- scratch on each one. Replace it with a real indexed table. `mangas.filtered_scanlators` stays
-- as the serialised form the app model and backups use; this table is what queries join to.
CREATE TABLE IF NOT EXISTS excluded_scanlators(
    manga_id INTEGER NOT NULL,
    scanlator TEXT NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES mangas (_id)
    ON DELETE CASCADE
);

CREATE UNIQUE INDEX IF NOT EXISTS excluded_scanlators_manga_id_scanlator_index
ON excluded_scanlators(manga_id, scanlator);

-- Backfill, using the same ' [.] ' separator ChapterUtil serialises with.
INSERT OR IGNORE INTO excluded_scanlators(manga_id, scanlator)
WITH RECURSIVE split(manga_id, name, str) AS (
    SELECT _id, NULL, filtered_scanlators || ' [.] '
    FROM mangas
    WHERE filtered_scanlators IS NOT NULL AND trim(filtered_scanlators) != ''
    UNION ALL SELECT
        manga_id,
        substr(str, 0, instr(str, ' [.] ')),
        substr(str, instr(str, ' [.] ') + 5)
    FROM split WHERE str != ''
)
SELECT manga_id, name FROM split WHERE name IS NOT NULL AND name != '';

DROP VIEW IF EXISTS scanlators_view;

DROP VIEW IF EXISTS library_view;
CREATE VIEW library_view AS
SELECT
    M.*,
    coalesce(C.total, 0) AS total,
    coalesce(C.read_count, 0) AS has_read,
    coalesce(C.bookmark_count, 0) AS bookmark_count,
    coalesce(MC.category_id, 0) AS category,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.lastFetch, 0) AS lastFetch
FROM mangas AS M
LEFT JOIN (
    SELECT
        chapters.manga_id,
        count(*) AS total,
        sum(read) AS read_count,
        sum(bookmark) AS bookmark_count,
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.history_last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS lastFetch
    FROM chapters
    LEFT JOIN excluded_scanlators AS filtered_scanlators
    ON chapters.manga_id = filtered_scanlators.manga_id
    AND chapters.scanlator = filtered_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.history_chapter_id
    WHERE filtered_scanlators.scanlator IS NULL
    GROUP BY chapters.manga_id
) AS C
ON M._id = C.manga_id
LEFT JOIN (SELECT * FROM mangas_categories) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 1
ORDER BY M.title;
